# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to Git!
# ==============================================================================

# --- General Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# --- PostgreSQL / PostGIS Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tfm_gis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password_in_local_env
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- MLOps & Tracking (MLflow / DVC) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tfm_infrastructure_abandonment

# --- AI & LLM APIs ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Geospatial Data Services (PNOA / IGN / LiDAR) ---
PNOA_WMS_URL=https://www.ign.es/wms-inspire/pnoa-ma
DATA_DIR=./data
CACHE_DIR=./data/cache

# --- API & Backend Service (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=generate_a_secure_random_key_for_sessions

# --- Geo-Decay Runtime Settings (read by geo_decay_delivery.config.Settings) ---
# Target extent as min_x,min_y,max_x,max_y (x first, then y); replace with your own.
GEO_DECAY_BBOX=min_x,min_y,max_x,max_y
# Authority code the bounding box is expressed in (AUTHORITY:CODE); chosen per ADR-004.
GEO_DECAY_BBOX_CRS=AUTHORITY:CODE
# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
GEO_DECAY_LOG_LEVEL=INFO
# Logging output format: text or json.
GEO_DECAY_LOG_FORMAT=text
# Base directory for data written by later sprints.
GEO_DECAY_DATA_DIR=data
# Project-wide deterministic seed (declared only; not applied yet).
GEO_DECAY_RANDOM_SEED=42
